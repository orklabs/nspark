<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NSpark\NSpark.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <!-- Copy the spark_frost native library to the output root so P/Invoke finds it during tests:
       a project reference does not list runtimes/{rid}/native assets in the deps file. -->
  <PropertyGroup>
    <SparkFrostArch>$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</SparkFrostArch>
    <SparkFrostRuntimes>..\..\src\NSpark\runtimes</SparkFrostRuntimes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(SparkFrostRuntimes)\osx-$(SparkFrostArch)\native\libspark_frost.dylib"
          CopyToOutputDirectory="PreserveNewest"
          Link="libspark_frost.dylib"
          Condition="$([MSBuild]::IsOSPlatform('osx')) and Exists('$(SparkFrostRuntimes)\osx-$(SparkFrostArch)\native\libspark_frost.dylib')" />
    <None Include="$(SparkFrostRuntimes)\linux-$(SparkFrostArch)\native\libspark_frost.so"
          CopyToOutputDirectory="PreserveNewest"
          Link="libspark_frost.so"
          Condition="$([MSBuild]::IsOSPlatform('linux')) and Exists('$(SparkFrostRuntimes)\linux-$(SparkFrostArch)\native\libspark_frost.so')" />
    <None Include="$(SparkFrostRuntimes)\win-$(SparkFrostArch)\native\spark_frost.dll"
          CopyToOutputDirectory="PreserveNewest"
          Link="spark_frost.dll"
          Condition="$([MSBuild]::IsOSPlatform('windows')) and Exists('$(SparkFrostRuntimes)\win-$(SparkFrostArch)\native\spark_frost.dll')" />
  </ItemGroup>

</Project>
